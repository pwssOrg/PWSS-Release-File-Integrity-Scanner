#! /bin/bash
<< Script_Information
Updated: Nov-2026
Purpose: Script used for installing Integrity Hash
Script_Version:1.8
Script_Information

: '
This script will install Integrity Hash on your computer. It will download Java (jdk) (if needed) and Postgres SQL.
Please note , if you have an existing Postgres installation - Talk to PWSS Representants before running it. In that case ,
it may be a better option to insert the tables manually into your database
'
set -euo pipefail

echo "======================================================"
echo "              PWSS Org Automated Installer           "
echo "======================================================"

echo "======================================================"
echo "        PostgreSQL + Java Automated Installer        "
echo "======================================================"

echo ""
echo "[INFO] PostgreSQL Installation & Setup"

### --- CHECK FOR EXISTING POSTGRESQL CLUSTERS ---
echo "[INFO] Checking for existing PostgreSQL clusters..."

if command -v pg_lsclusters >/dev/null 2>&1; then

    EXISTING_CLUSTERS=$(sudo pg_lsclusters --no-header 2>/dev/null || true)

    if [[ -n "$EXISTING_CLUSTERS" ]]; then
        echo ""
        echo "[WARNING] Existing PostgreSQL cluster(s) detected!"
        echo ""
        sudo pg_lsclusters

        echo ""
        echo "[ERROR] Installation aborted."
        echo "[INFO] An existing PostgreSQL installation was detected."
        echo "[INFO] Please contact PWSS representatives before proceeding."
        echo ""

        exit 1
    fi

else
    echo "[INFO] PostgreSQL cluster manager not found."
    echo "[INFO] No existing clusters detected through pg_lsclusters."
fi


### --- INTERACTIVE JAVA INSTALLATION ---
read -p "Do you want to install Java (JDK 25 or JDK 21)? [y/N]: " INSTALL_JAVA

if [[ "$INSTALL_JAVA" =~ ^[Yy]$ ]]; then
    echo "[INFO] Preparing to install Java..."
    sudo apt update -y

    if apt-cache search openjdk-25 | grep -q openjdk-25; then
        echo "[INFO] Installing OpenJDK 25..."
        sudo apt install -y openjdk-25-jdk
        JAVA_VERSION=25
    elif apt-cache search openjdk-21 | grep -q openjdk-21; then
        echo "[INFO] Installing OpenJDK 21..."
        sudo apt install -y openjdk-21-jdk
        JAVA_VERSION=21
    else
        echo "[ERROR] Neither JDK 25 nor JDK 21 available!"
        exit 1
    fi

    echo "[INFO] Java installation complete. Installed JDK version: $JAVA_VERSION"
    java -version
else
    echo "[INFO] Skipping Java installation as per user choice."
fi

echo ""

### --- INSTALL POSTGRESQL IF NEEDED ---

if ! dpkg-query -W -f='${Status}' postgresql 2>/dev/null | grep -q 'install ok installed'; then
    echo "[INFO] PostgreSQL server not found. Installing..."
    sudo apt update
    sudo apt install -y postgresql postgresql-contrib
else
    echo "[INFO] PostgreSQL server is already installed."
fi

### --- DETECT POSTGRESQL CLUSTER ---

echo "[INFO] Detecting PostgreSQL cluster..."

CLUSTER_INFO=$(sudo pg_lsclusters --no-header)

if [[ -z "$CLUSTER_INFO" ]]; then
    echo "[ERROR] No PostgreSQL cluster found!"
    exit 1
fi

# This installer expects exactly one cluster.
if [[ $(printf '%s\n' "$CLUSTER_INFO" | wc -l) -ne 1 ]]; then
    echo "[ERROR] Multiple PostgreSQL clusters detected!"
    sudo pg_lsclusters
    exit 1
fi

read -r PG_VERSION PG_CLUSTER CURRENT_PORT CLUSTER_STATUS \
    PG_OWNER DATA_DIR LOG_FILE <<< "$CLUSTER_INFO"

PORT=26556

echo "[INFO] PostgreSQL version: $PG_VERSION"
echo "[INFO] PostgreSQL cluster: $PG_CLUSTER"
echo "[INFO] PostgreSQL status: $CLUSTER_STATUS"


### --- ASK USER FOR DB CREDENTIALS ---
read -p "Enter database user: " DB_USER
read -sp "Enter database password: " DB_PASSWORD
echo ""

DB_NAME="integrity_hash"
PORT=26556

TRUSTSTORE_FIS_GUI="fklkfgKek"
ssl_file_integrity_scanner="Y_VYgqCLfvg9Q"

echo "[INFO] PostgreSQL Installation & SSL Setup"

# --- DETECT PG VERSION ---
PG_VERSION=$(psql --version | awk '{print $3}' | cut -d. -f1)
echo "[INFO] Detected PostgreSQL major version: $PG_VERSION"

### --- POSTGRESQL VERSION COMPATIBILITY CHECK ---

CONF_SRC="psql_files/postgresql.conf"

echo "[INFO] Checking PostgreSQL configuration compatibility..."

if [[ ! -f "$CONF_SRC" ]]; then
    echo "[ERROR] Configuration file not found: $CONF_SRC"
    exit 1
fi

if [[ "$PG_VERSION" =~ ^[0-9]+$ ]] && (( PG_VERSION <= 14 )); then
    echo "[INFO] PostgreSQL $PG_VERSION detected."
    echo "[INFO] Disabling unsupported scram_iterations parameter..."

    sed -i '/^[[:space:]]*scram_iterations[[:space:]]*=[[:space:]]*4096[[:space:]]*$/s/^/#/' "$CONF_SRC"

    echo "[INFO] Configuration adjusted."
else
    echo "[INFO] PostgreSQL $PG_VERSION detected. No compatibility changes required."
fi





# --- COPY SSL-CONFIG FILES ---
CONF_SRC="psql_files/postgresql.conf"
CONF_DEST="/etc/postgresql/${PG_VERSION}/main/postgresql.conf"

if [ ! -f "$CONF_SRC" ]; then
    echo "[ERROR] Source postgresql.conf not found at $CONF_SRC"
    exit 1
fi

echo "[INFO] Copying postgresql.conf with SSL settings..."
sudo cp "$CONF_SRC" "$CONF_DEST"
sudo chown postgres:postgres "$CONF_DEST"
sudo chmod 600 "$CONF_DEST"

# --- COPY CERTS AND OTHER FILES ---
echo "[INFO] Copying psql SSL certs and scripts..."
sudo cp -r psql_files/psql /tmp

sudo mv /tmp/psql/cert/p_avocado.crt /etc/ssl/certs/
sudo mv /tmp/psql/cert/p_avocado.key /etc/ssl/private/
sudo chmod 600 /etc/ssl/private/p_avocado.key
sudo chown postgres:postgres /etc/ssl/private/p_avocado.key

sudo mv /tmp/psql/pass/avocado /etc/postgresql/${PG_VERSION}/main/ssl-pass.sh
sudo chmod 700 /etc/postgresql/${PG_VERSION}/main/ssl-pass.sh
sudo chown postgres:postgres /etc/postgresql/${PG_VERSION}/main/ssl-pass.sh

# --- Replace all versionspecific paths in postgresql.conf ---
sudo sed -i "s#/var/lib/postgresql/[0-9]\+/main#/var/lib/postgresql/${PG_VERSION}/main#g" "$CONF_DEST"
sudo sed -i "s#/etc/postgresql/[0-9]\+/main#/etc/postgresql/${PG_VERSION}/main#g" "$CONF_DEST"
sudo sed -i "s#/var/run/postgresql/[0-9]\+-main.pid#/var/run/postgresql/${PG_VERSION}-main.pid#g" "$CONF_DEST"
# --- START POSTGRESQL ---
echo "[INFO] Starting PostgreSQL $PG_VERSION/$PG_CLUSTER..."


### --- DETECT POSTGRESQL CLUSTER ---

echo "[INFO] Detecting PostgreSQL cluster..."

CLUSTER_INFO=$(sudo pg_lsclusters --no-header)

if [[ -z "$CLUSTER_INFO" ]]; then
    echo "[ERROR] No PostgreSQL cluster found!"
    exit 1
fi

read -r PG_VERSION PG_CLUSTER CURRENT_PORT CLUSTER_STATUS \
    PG_OWNER DATA_DIR LOG_FILE <<< "$CLUSTER_INFO"

PORT=26556

echo "[INFO] PostgreSQL version: $PG_VERSION"
echo "[INFO] PostgreSQL cluster: $PG_CLUSTER"
echo "[INFO] PostgreSQL port: $PORT"
echo "[INFO] PostgreSQL status: $CLUSTER_STATUS"
echo "[INFO] PostgreSQL log: $LOG_FILE"

### --- START OR RESTART POSTGRESQL ---

echo "[INFO] Checking PostgreSQL cluster status..."

CLUSTER_STATUS=$(sudo pg_lsclusters --no-header |
    awk -v ver="$PG_VERSION" -v cluster="$PG_CLUSTER" \
    '$1 == ver && $2 == cluster {print $4}')

if [[ -z "$CLUSTER_STATUS" ]]; then
    echo "[ERROR] Could not determine PostgreSQL cluster status."
    exit 1
fi

if [[ "$CLUSTER_STATUS" == "online" ]]; then
    echo "[INFO] Cluster is running. Restarting..."
    sudo pg_ctlcluster "$PG_VERSION" "$PG_CLUSTER" restart
else
    echo "[INFO] Cluster is stopped. Starting..."
    sudo pg_ctlcluster "$PG_VERSION" "$PG_CLUSTER" start
fi

echo "[INFO] Waiting for PostgreSQL..."

for i in {1..20}; do
    if pg_isready -h 127.0.0.1 -p "$PORT" -q; then
        echo "[INFO] PostgreSQL successfully started on port $PORT"
        break
    fi
    sleep 1
done

if ! pg_isready -h 127.0.0.1 -p "$PORT" -q; then
    echo "[ERROR] PostgreSQL is not responding on port $PORT"
    sudo tail -50 "$LOG_FILE"
    exit 1
fi



# --- CREATE USER ---
echo "[INFO] Creating database user if not exist..."
USER_EXISTS=$(sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='$DB_USER'" -p $PORT)
if [[ $USER_EXISTS != "1" ]]; then
    echo "[INFO] User $DB_USER does not exist. Creating..."
    sudo -u postgres psql -p $PORT -c "CREATE ROLE \"$DB_USER\" LOGIN PASSWORD '$DB_PASSWORD';"
else
    echo "[INFO] User $DB_USER already exists. Skipping creation."
fi

# --- CREATE DATABASE ---
DB_EXISTS=$(sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'" -p $PORT)
if [[ $DB_EXISTS != "1" ]]; then
    echo "[INFO] Database $DB_NAME does not exist. Creating..."
    sudo -u postgres psql -p $PORT -c "CREATE DATABASE \"$DB_NAME\" OWNER \"$DB_USER\";"
else
    echo "[INFO] Database $DB_NAME already exists. Skipping creation."
fi

# --- CREATE TABLES ---
echo "[INFO] Creating tables..."
sudo -u postgres psql -d "$DB_NAME" -p $PORT <<'EOF'
CREATE TABLE IF NOT EXISTS "time"(id BIGSERIAL PRIMARY KEY, created TIMESTAMPTZ NOT NULL, updated TIMESTAMPTZ NOT NULL);
CREATE TABLE IF NOT EXISTS note (id BIGSERIAL PRIMARY KEY, notes TEXT, prev_notes TEXT, prev_prev_notes TEXT, time_id bigint NOT NULL REFERENCES "time"(id));
CREATE TABLE IF NOT EXISTS file (id BIGSERIAL PRIMARY KEY, path TEXT NOT NULL UNIQUE, basename TEXT NOT NULL, directory TEXT NOT NULL, size bigint NOT NULL, mtime TIMESTAMPTZ NOT NULL);
CREATE TABLE IF NOT EXISTS checksum (id BIGSERIAL PRIMARY KEY, file_id bigint NOT NULL REFERENCES file(id), checksum_sha256 TEXT NOT NULL, checksum_sha3 TEXT NOT NULL, checksum_blake_2b TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS monitored_directory (id SERIAL PRIMARY KEY, path TEXT NOT NULL UNIQUE, is_active BOOLEAN NOT NULL DEFAULT TRUE, time_id bigint NOT NULL REFERENCES "time"(id), last_scanned TIMESTAMPTZ, note_id bigint NOT NULL REFERENCES note(id), baseline_established BOOLEAN NOT NULL DEFAULT FALSE, include_subdirectories BOOLEAN NOT NULL DEFAULT TRUE);
CREATE TABLE IF NOT EXISTS scan (id SERIAL PRIMARY KEY, scan_time_id bigint NOT NULL REFERENCES "time"(id), status TEXT NOT NULL, note_id bigint NOT NULL REFERENCES note(id), monitored_directory_id INTEGER NOT NULL REFERENCES monitored_directory(id), is_baseline_scan BOOLEAN NOT NULL);
CREATE TABLE IF NOT EXISTS scan_summary (id BIGSERIAL PRIMARY KEY, scan_id INTEGER NOT NULL REFERENCES scan(id), file_id bigint NOT NULL REFERENCES file(id), checksum_id bigint NOT NULL REFERENCES checksum(id));
CREATE TABLE IF NOT EXISTS diff (id BIGSERIAL PRIMARY KEY, baseline_id bigint NOT NULL REFERENCES scan_summary(id), integrity_fail_id bigint NOT NULL REFERENCES scan_summary(id), time_id bigint NOT NULL REFERENCES "time"(id));
CREATE TABLE IF NOT EXISTS auth(id SERIAL PRIMARY KEY, hash TEXT NOT NULL, auth_time bigint REFERENCES "time"(id) NOT NULL);
CREATE TABLE IF NOT EXISTS "user_"(id SERIAL PRIMARY KEY, username TEXT UNIQUE NOT NULL, auth_id int REFERENCES auth(id) NOT NULL, user_time bigint REFERENCES "time"(id) NOT NULL);
CREATE TABLE IF NOT EXISTS license(id INT PRIMARY KEY, license_data TEXT);
INSERT INTO license (id,license_data) VALUES
(1,'b289ab93856e4e3411dbbc79f151c727aba2621be5a61c27686d5410eb5ca8ac'),
(2,'31a084dcff2e114d601027eb1f3137faaaa1d07e452960759a73064f72d2292a')
ON CONFLICT DO NOTHING;
EOF

# --- SET TABLE & DB OWNERSHIP ---
TABLES=(time note file checksum monitored_directory scan scan_summary diff auth user_ license)
for t in "${TABLES[@]}"; do
    sudo -u postgres psql -d "$DB_NAME" -p $PORT -c "ALTER TABLE IF EXISTS \"$t\" OWNER TO \"$DB_USER\";"
done
sudo -u postgres psql -p $PORT -c "ALTER DATABASE \"$DB_NAME\" OWNER TO \"$DB_USER\";"

echo "[INFO] PostgreSQL setup complete with SSL!"


# --- SET Execution permissons for Integrity Hash files ---
FILE_PATH="setup_enviroment/integrity_hash_enviroment"
# Check if integrity_hash_enviroment exists
if [[ -f "$FILE_PATH" ]]; then
  # Check if integrity_hash_enviroment is executable
  if [[ ! -x "$FILE_PATH" ]]; then

   sudo chmod +x "$FILE_PATH"
  fi
else
  echo "Error: File '$FILE_PATH' does not exist."
fi

FILE_PATH_2="../file_integrity_scanner_app/linux/start_integrity_hash"

# Check if start_integrity_hash exists
if [[ -f "$FILE_PATH_2" ]]; then
  # Check if start_integrity_hash is executable
  if [[ ! -x "$FILE_PATH_2" ]]; then

   sudo chmod +x "$FILE_PATH_2"
  fi
else
  echo "Error: File '$FILE_PATH_2' does not exist."
fi


echo "[INFO] Setting environment variables and aliases..."
bash setup_enviroment/integrity_hash_enviroment $(realpath ../file_integrity_scanner_app/) $DB_USER $DB_PASSWORD $TRUSTSTORE_FIS_GUI $ssl_file_integrity_scanner


echo ""
echo "======================================================"
echo "       INTEGRITY HASH - INSTALLATION COMPLETE"
echo "======================================================"
echo ""
echo "[INFO] Environment configuration has been saved"
echo "for future terminal sessions."
echo ""
echo "Please restart your terminal to make the environment"
echo "variables and aliases available."
echo ""
echo "------------------------------------------------------"
echo "ALIASES INCLUDED:"
echo "------------------------------------------------------"
echo "integrity_hash          - Starts Integrity Hash"
echo "integrity_hash_version  - Displays Integrity Hash version"
echo "integrity_hash_path     - Navigates to the application folder"
echo ""
echo "------------------------------------------------------"
echo "ENVIRONMENT VARIABLES INCLUDED:"
echo "------------------------------------------------------"
echo "integrity_hash_app_folder"
echo "    - File-Integrity-Scanner App directory"
echo ""
echo "INTEGRITY_HASH_DB_USER"
echo "    - Database username"
echo "    [SECURITY] Remove from ~/.bashrc on shared computers"
echo "    when not using Integrity Hash."
echo ""
echo "INTEGRITY_HASH_DB_PASSWORD"
echo "    - Database password"
echo "    [SECURITY] Remove from ~/.bashrc on shared computers"
echo "    when not using Integrity Hash."
echo ""
echo "TRUSTSTORE_FIS_GUI"
echo "    - GUI client truststore password"
echo "    [INFO] Publicly available as part of this"
echo "    open-source project."
echo ""
echo "ssl_file_integrity_scanner"
echo "    - File Integrity Scanner SSL password"
echo "    [INFO] Publicly available as part of this"
echo "    open-source project."
echo ""
echo "------------------------------------------------------"
echo "DATABASE CONNECTION:"
echo "------------------------------------------------------"
echo "psql -d \"$DB_NAME\" -U \"$DB_USER\" -h localhost -p \"$PORT\" -W"
echo ""
echo "======================================================"
echo "       THANK YOU FOR USING INTEGRITY HASH!"
echo "======================================================"
echo ""
